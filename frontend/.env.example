# Copy to .env.local and fill in.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — bypasses RLS. Used server-only (src/lib/server/serviceRole.ts).
SUPABASE_SECRET_KEY=

# --- Auth ---
NEXT_PUBLIC_AUTH_CALLBACK_URL=

# --- Feature flags ---
NEXT_PUBLIC_ENABLE_MATCH_REQUESTS=

# --- Matching algorithm ---
# Server-only — never exposed to the browser. The admin "Run Matching" page
# (src/app/admin/matching) calls this through this app's own /api/admin/matching/*
# routes, which proxy to it; the browser never talks to it directly.
# The algorithm itself (ml_microservice) is deployed as a second container
# alongside aspc-website-v2's backend, reachable only through that backend's
# own public URL + /api/ml — not a separate host of its own.
# See aspc-website-v2/backend/.env.example for the other side of this.
ALGORITHM_SERVICE_URL=https://api.pomonastudents.org/api/ml
# Must match ML_PROXY_API_KEY, set as a GitHub secret on aspc-website-v2
# (gh secret set ML_PROXY_API_KEY there — it's a GitHub Actions secret, not
# something that lives in this repo or Vercel automatically).
ALGORITHM_SERVICE_API_KEY=
