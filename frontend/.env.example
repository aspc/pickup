# Copy to .env.local and fill in.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — bypasses RLS. Used server-only (src/lib/server/serviceRole.ts).
SUPABASE_SECRET_KEY=

# --- Auth ---
NEXT_PUBLIC_AUTH_CALLBACK_URL=

# --- Feature flags ---
NEXT_PUBLIC_ENABLE_MATCH_REQUESTS=

# --- Matching algorithm ---
# Server-only — never exposed to the browser. The admin "Run Matching" page
# (src/app/admin/matching) calls this through this app's own /api/admin/matching/*
# routes, which proxy to it; the browser never talks to it directly.
# The algorithm itself runs as a separate AWS Lambda function (pickup-matching),
# not in this Netlify app. Its code and deploy steps live outside this repo.
# The Lambda's Function URL, e.g. https://abc123.lambda-url.us-west-1.on.aws
# (or http://localhost:8000 when running the matching service locally with uvicorn).
ALGORITHM_SERVICE_URL=
# Must match SERVICE_API_KEY set on the Lambda function.
ALGORITHM_SERVICE_API_KEY=
